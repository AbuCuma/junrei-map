# 复制为 local.properties 并按需填写(local.properties 已被 .gitignore 忽略,勿提交)。

# Android SDK 路径(Android Studio 通常会自动生成)
sdk.dir=/Users/you/Library/Android/sdk

# Google Maps API key(必填,否则地图空白)。
# 在 Google Cloud Console 创建,务必加「Android 应用」限制(包名 + SHA-1)与 Maps SDK API 限制。
MAPS_API_KEY=

# 抠图运行时(ISNet + ONNX Runtime + QNN)清单地址(可选)。
# 留空 = 禁用 ISNet,人物抠图自动回落 ML Kit,应用其余功能不受影响。
# 本地调试可用 `adb reverse tcp:8765 tcp:8765` + `python3 -m http.server 8765`
# 配合 tools/build_cutout_manifest.py 生成的 dist 目录(debug 变体已允许 cleartext)。
CUTOUT_MANIFEST_URL=

# Release 签名(仅维护者需要;四个都填才生效,否则 assembleRelease 产出未签名 APK)。
# 也可以用同名环境变量提供(CI)。keystore 本身勿放进仓库(.gitignore 已排除 *.jks)。
RELEASE_STORE_FILE=~/.junreimap_release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=junreimap
RELEASE_KEY_PASSWORD=
